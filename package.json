{
  "name": "streetview-metingen",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "Google Maps Street View meetoverlay zonder Google API-sleutel, met PDOK AHN",
  "scripts": {
    "test": "node --test",
    "desktop": "electron .",
    "dist:win": "electron-builder --win portable nsis --publish never"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "desktop-google/main.cjs",
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "nl.streetviewmetingen.googlekeyless",
    "productName": "Streetview Metingen",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop-google/**/*",
      "src/ahn.mjs",
      "src/geometry.mjs",
      "package.json"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
